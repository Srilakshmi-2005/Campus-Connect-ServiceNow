    <sp_widget action="DELETE">
        <category>custom</category>
        <client_script><![CDATA[api.controller=function() {
  /* widget controller */
  var c = this;
};]]></client_script>
        <controller_as>c</controller_as>
        <css>&lt;div class="panel panel-default"&gt;&#13;
  &lt;div class="panel-heading"&gt;&#13;
    &lt;h3&gt;Upcoming Verified Events&lt;/h3&gt;&#13;
  &lt;/div&gt;&#13;
  &lt;div class="panel-body"&gt;&#13;
    &lt;div ng-repeat="event in data.events" class="event-card"&gt;&#13;
      &lt;h4&gt;{{event.name}} &lt;small&gt;({{event.type}})&lt;/small&gt;&lt;/h4&gt;&#13;
      &lt;p&gt;&lt;strong&gt;Tags:&lt;/strong&gt; {{event.tags}}&lt;/p&gt;&#13;
      &lt;p&gt;&lt;strong&gt;Date:&lt;/strong&gt; {{event.date}} &amp;nbsp; | &amp;nbsp; &lt;strong&gt;Deadline:&lt;/strong&gt; {{event.deadline}}&lt;/p&gt;&#13;
      &lt;p&gt;&lt;strong&gt;Location:&lt;/strong&gt; {{event.location}}&#13;
        &lt;a href="{{event.maps_link}}" target="_blank"&gt;(View on Map)&lt;/a&gt;&#13;
      &lt;/p&gt;&#13;
      &lt;p&gt;&lt;strong&gt;Fees:&lt;/strong&gt; {{event.fees}}&lt;/p&gt;&#13;
      &lt;hr&gt;&#13;
    &lt;/div&gt;&#13;
    &lt;div ng-if="data.events.length == 0"&gt;&#13;
      &lt;p&gt;No verified events available right now.&lt;/p&gt;&#13;
    &lt;/div&gt;&#13;
  &lt;/div&gt;&#13;
&lt;/div&gt;</css>
