        <script><![CDATA[(function() {

    /*
     * ==========================================
     * MENTOR CONNECT RECORD PRODUCER
     * ==========================================
     *
     * Producer variables:
     *
     * from
     * post_type
     * domain_tag
     * related_event
     * content
     *
     * Author is automatically assigned to
     * the currently logged-in user.
     */

    current.from = producer.from;
    current.post_type = producer.post_type;
    current.domain_tag = producer.domain_tag;

    /*
     * Save the selected Event reference.
     */
    if (producer.related_event) {
        current.related_event = producer.related_event.toString();
    }

    current.content = producer.content;
    current.author = gs.getUserID();

    /*
     * New Mentor Connect posts are open.
     */
    current.resolved_clarified = false;

    /*
     * Return to Mentor Connect after submission.
     */
    producer.portal_redirect = "?id=mentor_connect";

})();]]></script>
