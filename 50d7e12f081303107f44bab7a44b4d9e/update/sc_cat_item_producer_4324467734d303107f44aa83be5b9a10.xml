        <script><![CDATA[/** This script is executed before the Record is generated
 * `current`- GlideRecord produced by Record Producer
 * Don't use `current.update()` or `current.insert()` as the record is generated by Record Producer
 * Don't use `current.setValue('sys_class_name', 'xxx')`
 */


/*
 * =====================================================
 * CURRENT LOGGED-IN STUDENT
 * =====================================================
 */

var currentStudent = gs.getUserID();


/*
 * =====================================================
 * EVENT
 * =====================================================
 */

current.event = producer.event;


/*
 * =====================================================
 * CHECK DUPLICATE REGISTRATION
 * =====================================================
 *
 * Same student cannot register for the same event twice.
 */

var duplicateRegistration = new GlideRecord(
    'x_snc_campus_con_0_registrations'
);

duplicateRegistration.addQuery(
    'student',
    currentStudent
);

duplicateRegistration.addQuery(
    'event',
    producer.event
);

duplicateRegistration.setLimit(1);
duplicateRegistration.query();


if (duplicateRegistration.next()) {

    gs.addErrorMessage(
        "You have already registered for this event."
    );

    producer.portal_redirect =
        "?id=campus_connect_home";

} else {


    /*
     * =================================================
     * CREATE REGISTRATION
     * =================================================
     */

    current.student = currentStudent;

    current.contact_number =
        producer.contact_number;

    current.registration_date =
        new GlideDateTime();

    current.registration_status =
        'registered';


    gs.addInfoMessage(
        "✅ Registration submitted successfully! Your registration has been stored."
    );


    /*
     * Redirect to Campus Connect Home
     */

    producer.portal_redirect =
        "?id=campus_connect_home";
}]]></script>
