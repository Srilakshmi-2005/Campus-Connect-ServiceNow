<?xml version="1.0" encoding="UTF-8"?><record_update table="sp_css">
    <sp_css action="INSERT_OR_UPDATE">
        <css>/* =========================================================&#13;
   CAMPUS CONNECT - GLOBAL UI SPACING &amp; SIZING&#13;
   ONLY adjusts layout width, spacing and widget gaps.&#13;
   NO colors, images or functionality changed.&#13;
   ========================================================= */&#13;
&#13;
&#13;
/* =========================================================&#13;
   1. MAIN SERVICE PORTAL PAGE&#13;
   ========================================================= */&#13;
&#13;
body {&#13;
    margin: 0 !important;&#13;
    padding: 0 !important;&#13;
    overflow-x: hidden !important;&#13;
}&#13;
&#13;
#sp-page-root {&#13;
    width: 100% !important;&#13;
    max-width: 100% !important;&#13;
    margin: 0 !important;&#13;
    padding: 0 !important;&#13;
}&#13;
&#13;
&#13;
/* =========================================================&#13;
   2. MAIN PAGE CONTENT&#13;
   ========================================================= */&#13;
&#13;
#sp-page-root .sp-page {&#13;
    width: 100% !important;&#13;
    max-width: 100% !important;&#13;
    margin: 0 !important;&#13;
    padding: 0 !important;&#13;
}&#13;
&#13;
#sp-page-root .sp-page-content {&#13;
    width: 100% !important;&#13;
    max-width: 100% !important;&#13;
}&#13;
&#13;
&#13;
/* =========================================================&#13;
   3. BOOTSTRAP CONTAINERS&#13;
   ========================================================= */&#13;
&#13;
#sp-page-root .container,&#13;
#sp-page-root .container-fluid {&#13;
    width: 100% !important;&#13;
    max-width: 100% !important;&#13;
}&#13;
&#13;
&#13;
/* =========================================================&#13;
   4. ROW SPACING&#13;
   ========================================================= */&#13;
&#13;
#sp-page-root .row {&#13;
    width: 100% !important;&#13;
}&#13;
&#13;
&#13;
/* =========================================================&#13;
   5. WIDGET COLUMNS&#13;
   ========================================================= */&#13;
&#13;
#sp-page-root .col-xs-12,&#13;
#sp-page-root .col-sm-12,&#13;
#sp-page-root .col-md-12,&#13;
#sp-page-root .col-lg-12 {&#13;
    width: 100% !important;&#13;
}&#13;
&#13;
&#13;
/* =========================================================&#13;
   6. WIDGET AREA&#13;
   ========================================================= */&#13;
&#13;
#sp-page-root .widget {&#13;
    width: 100%;&#13;
    max-width: 100%;&#13;
}&#13;
&#13;
&#13;
/* =========================================================&#13;
   7. WIDGET PANELS&#13;
   Adds spacing without changing their design.&#13;
   ========================================================= */&#13;
&#13;
#sp-page-root .panel {&#13;
    margin-bottom: 20px !important;&#13;
}&#13;
&#13;
&#13;
/* =========================================================&#13;
   8. CAMPUS CONNECT CUSTOM PAGES&#13;
   ========================================================= */&#13;
&#13;
.campus-home,&#13;
.campus-connect-page,&#13;
.mentor-connect-page {&#13;
    width: 100% !important;&#13;
    max-width: 100% !important;&#13;
}&#13;
&#13;
&#13;
/* =========================================================&#13;
   9. LANDING PAGE&#13;
   ========================================================= */&#13;
&#13;
.campus-home {&#13;
    min-height: 100vh;&#13;
    width: 100% !important;&#13;
}&#13;
&#13;
&#13;
/* =========================================================&#13;
   10. LANDING PAGE HERO&#13;
   ========================================================= */&#13;
&#13;
.campus-home .cc-hero {&#13;
    width: 100% !important;&#13;
}&#13;
&#13;
.campus-home .cc-hero-inner {&#13;
    width: 100% !important;&#13;
}&#13;
&#13;
&#13;
/* =========================================================&#13;
   11. HOME PAGE CONTENT&#13;
   ========================================================= */&#13;
&#13;
.cc-main,&#13;
.cc-content,&#13;
.campus-content {&#13;
    width: 100% !important;&#13;
    max-width: 100% !important;&#13;
}&#13;
&#13;
&#13;
/* =========================================================&#13;
   12. COMMON CARD / WIDGET SPACING&#13;
   ========================================================= */&#13;
&#13;
.cc-card,&#13;
.cc-widget,&#13;
.home-card,&#13;
.dashboard-card {&#13;
    margin-bottom: 20px;&#13;
}&#13;
&#13;
&#13;
/* =========================================================&#13;
   13. DESKTOP&#13;
   ========================================================= */&#13;
&#13;
@media (min-width: 1200px) {&#13;
&#13;
    #sp-page-root .container,&#13;
    #sp-page-root .container-fluid {&#13;
        width: 100% !important;&#13;
        max-width: 100% !important;&#13;
    }&#13;
&#13;
}&#13;
&#13;
&#13;
/* =========================================================&#13;
   14. TABLET&#13;
   ========================================================= */&#13;
&#13;
@media (min-width: 768px) and (max-width: 1199px) {&#13;
&#13;
    #sp-page-root .container,&#13;
    #sp-page-root .container-fluid {&#13;
        width: 100% !important;&#13;
        max-width: 100% !important;&#13;
    }&#13;
&#13;
}&#13;
&#13;
&#13;
/* =========================================================&#13;
   15. MOBILE&#13;
   ========================================================= */&#13;
&#13;
@media (max-width: 767px) {&#13;
&#13;
    #sp-page-root,&#13;
    #sp-page-root .sp-page,&#13;
    #sp-page-root .sp-page-content {&#13;
        width: 100% !important;&#13;
        max-width: 100% !important;&#13;
        margin: 0 !important;&#13;
    }&#13;
&#13;
    #sp-page-root .widget {&#13;
        margin-bottom: 16px !important;&#13;
    }&#13;
&#13;
}</css>
