        <name>Browse Events</name>
        <option_schema/>
        <public>false</public>
        <roles/>
        <script><![CDATA[(function() {
    data.events = [];

    var gr = new GlideRecord('x_snc_campus_con_0_events');
    gr.addQuery('verification_status', 'verified');
    gr.orderBy('event_date');
    gr.query();

    while (gr.next()) {
        data.events.push({
            sys_id: gr.getUniqueValue(),
            name: gr.event_name.toString(),
            type: gr.event_type.toString(),
            tags: gr.technology_tags.toString(),
            date: gr.event_date.getDisplayValue(),
            deadline: gr.registration_deadline.getDisplayValue(),
            location: gr.location.toString(),
            maps_link: gr.google_maps_link.toString(),
            fees: gr.fees.toString()
        });
    }
})();]]></script>
